{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "labFolder",
            "type": "pickString",
            "description": "Which Lab do you want to compile and run?",
            "options": [
                "Lab1(Server-Client)",
                "Lab2",
                "Lab3(SmartPointers)",
                "Lab4",
                "Lab5"
            ],
            "default": "Lab1(Server-Client)"
        }
    ],
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe Build Selected Lab",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++23",
                "-fdiagnostics-color=always",
                "-g",
                "src/*.cpp",
                "src/lib/*.cpp",
                "-I",
                "include",
                "-o",
                "${workspaceFolder}\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/${input:labFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
